#
# Run via hdl/formal/run_formal.sh frame_sync. Black-box harness on ports
# plus a ghost record; the state machine and correlator are replaced by
# contract stubs (frame_sync_stubs.v), each proved by its own job.

[tasks]
prove
cover

[options]
prove: mode bmc
prove: depth 30
cover: mode cover
cover: depth 40

[engines]
smtbmc yices

[script]
read_verilog -formal -I. frame_sync.v
read_verilog -formal -I. frame_sync_stubs.v
read_verilog -formal -I. frame_sync_formal.v
prep -top frame_sync_formal

[files]
axi4s_types.vh ../rtl/include/axi4s_types.vh
status_words.vh ../rtl/include/status_words.vh
frame_sync.v ../rtl/sync/frame_sync.v
frame_sync_stubs.v
frame_sync_formal.v
