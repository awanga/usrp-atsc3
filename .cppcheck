# cppcheck suppressions file for gr-atsc3
# Usage: cppcheck --suppressions-list=.cppcheck ...

# Suppress warnings about missing include files (handled by CMake)
missingInclude
missingIncludeSystem

# Suppress style warnings in test files
*:test/*

# Suppress warnings about GoogleTest macros
syntaxError:*gtest*
preprocessorErrorDirective:*gtest*

# Allow C-style casts in low-level DSP code (intentional for performance)
# cstyleCast:lib/*

# Suppress warnings about unused functions in header-only code
unusedFunction

# Allow variable shadowing in specific cases (common in DSP loops)
# shadowVariable:lib/ofdm/*

# Suppress inline suppression warnings
inlineSuppressionUnmatchedInlineSuppr

# GNU Radio block impl constructors are intentionally non-explicit (called via make())
noExplicitConstructor:blocks/*_impl.h

# Suppress style suggestions that don't improve code clarity
useStlAlgorithm:lib/framing/route_parser.cc
