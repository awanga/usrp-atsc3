# Git LFS tracking for IQ capture files
test/captures/*.iq filter=lfs diff=lfs merge=lfs -text
test/captures/*.sigmf-data filter=lfs diff=lfs merge=lfs -text
test/captures/*.sigmf-meta filter=lfs diff=lfs merge=lfs -text

# Ensure consistent line endings
*.cc text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cpp text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
Makefile text eol=lf

# Verilog/SystemVerilog
*.v text eol=lf
*.sv text eol=lf
*.vh text eol=lf
*.svh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
