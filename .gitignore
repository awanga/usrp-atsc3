# Build artifacts
build/
build-*/
cmake-build-*/
*.o
*.a
*.so
*.dylib

# IQ capture files are tracked via git-lfs in test/captures/
# Only ignore IQ files outside of test/captures/
/*.iq
/tmp/*.iq

# Python
__pycache__/
*.py[cod]
*.pyo
.python-version
venv/
.venv/

# GNU Radio
.grc_gnuradio/
*.grc.bak
# Generated Python from GRC (keep .grc, ignore generated .py)
apps/*.py

# CTest temporary files
Testing/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.project
.cproject
.settings/
*.sublime-workspace
*.sublime-project
.ccls-cache/
compile_commands.json

# Coverage artifacts
*.gcno
*.gcda
*.gcov
coverage/
lcov.info
coverage.info
htmlcov/

# Documentation build
docs/_build/
docs/doxygen/

# Package artifacts
*.deb
*.rpm
*.tar.gz
*.zip

# OS files
.DS_Store
Thumbs.db

# Credentials and secrets
*.pem
*.key
.env
.env.*

# Temporary files
tmp/
temp/
*.tmp
*.log
