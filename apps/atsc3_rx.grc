options:
  parameters:
    author: gr-atsc3
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: 'ATSC 3.0 Software-Defined Receiver

      For use with USRP N2x0 + TVRX daughterboard

      Complete receive chain with live A/V playback'
    copyright: ''
    description: Complete ATSC 3.0 physical layer receiver with live playback
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: atsc3_rx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: ATSC 3.0 Receiver
    window_size: (1400,1024)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
  - name: center_freq
    id: variable_qtgui_range
    parameters:
      comment: ''
      gui_hint: 0,0,1,1
      label: Center Frequency (MHz)
      min_len: '200'
      orient: QtCore.Qt.Horizontal
      rangeType: float
      start: '473'
      step: '6'
      stop: '803'
      value: '617'
      widget: counter_slider
    states:
      bus_sink: false
      bus_source: false
      bus_structure: null
      coordinate: [8, 160]
      rotation: 0
      state: enabled

  - name: rf_gain
    id: variable_qtgui_range
    parameters:
      comment: ''
      gui_hint: 0,1,1,1
      label: RF Gain (dB)
      min_len: '200'
      orient: QtCore.Qt.Horizontal
      rangeType: float
      start: '0'
      step: '1'
      stop: '50'
      value: '30'
      widget: counter_slider
    states:
      bus_sink: false
      bus_source: false
      bus_structure: null
      coordinate: [160, 160]
      rotation: 0
      state: enabled

  - name: volume
    id: variable_qtgui_range
    parameters:
      comment: ''
      gui_hint: 0,2,1,1
      label: Volume
      min_len: '100'
      orient: QtCore.Qt.Horizontal
      rangeType: float
      start: '0'
      step: '0.1'
      stop: '1.0'
      value: '0.8'
      widget: counter_slider
    states:
      bus_sink: false
      bus_source: false
      bus_structure: null
      coordinate: [312, 160]
      rotation: 0
      state: enabled

  - name: samp_rate
    id: variable
    parameters:
      comment: ''
      value: 6.144e6
    states:
      bus_sink: false
      bus_source: false
      bus_structure: null
      coordinate: [8, 96]
      rotation: 0
      state: enabled

  - name: fft_size
    id: variable
    parameters:
      comment: ''
      value: '8192'
    states:
      bus_sink: false
      bus_source: false
      bus_structure: null
      coordinate: [112, 96]
      rotation: 0
      state: enabled

  - name: cp_length
    id: variable
    parameters:
      comment: ''
      value: '1024'
    states:
      bus_sink: false
      bus_source: false
      bus_structure: null
      coordinate: [200, 96]
      rotation: 0
      state: enabled

  - name: pilot_pattern
    id: variable
    parameters:
      comment: ''
      value: '3'
    states:
      bus_sink: false
      bus_source: false
      bus_structure: null
      coordinate: [296, 96]
      rotation: 0
      state: enabled

  - name: modulation
    id: variable
    parameters:
      comment: '0=QPSK, 1=16QAM, 2=64QAM, 3=256QAM'
      value: '2'
    states:
      bus_sink: false
      bus_source: false
      bus_structure: null
      coordinate: [392, 96]
      rotation: 0
      state: enabled

  - name: code_rate
    id: variable
    parameters:
      comment: '0=2/15 to 11=13/15'
      value: '6'
    states:
      bus_sink: false
      bus_source: false
      bus_structure: null
      coordinate: [488, 96]
      rotation: 0
      state: enabled

  - name: ti_mode
    id: variable
    parameters:
      comment: '0=None, 1=CTI, 2=HTI'
      value: '1'
    states:
      bus_sink: false
      bus_source: false
      bus_structure: null
      coordinate: [584, 96]
      rotation: 0
      state: enabled

  - name: plp_id
    id: variable
    parameters:
      comment: ''
      value: '0'
    states:
      bus_sink: false
      bus_source: false
      bus_structure: null
      coordinate: [680, 96]
      rotation: 0
      state: enabled

  - name: service_id
    id: variable
    parameters:
      comment: '0 = first available'
      value: '0'
    states:
      bus_sink: false
      bus_source: false
      bus_structure: null
      coordinate: [776, 96]
      rotation: 0
      state: enabled

